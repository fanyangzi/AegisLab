# Website / API. Only configure values controlled by your deployment.
AEGIS_SERVE_WEB=0
AEGIS_WORKSPACE_TOKEN=
AEGIS_WORKSPACE_OWNER=本机负责人
AEGIS_SPATIAL_DB_PATH=backend/aegis-spatial.db
LABSAFETY_DB_PATH=backend/aegislab.db
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Empty uses the same origin and Vite /api proxy; never put a model key in VITE_*.
VITE_API_BASE_URL=

# Optional model adapter. No default third-party gateway or guessed model name.
LABSAFETY_LLM_ENABLED=1
LABSAFETY_LLM_BASE_URL=
LABSAFETY_LLM_MODEL=
LABSAFETY_LLM_API_KEY=
